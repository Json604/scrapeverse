# Copy to .env.local and fill in. NEVER commit the filled version.
# Real credentials currently live in atlas-credentials.env (gitignored).

# --- required ---
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>.mongodb.net"
# Database name is appended automatically if the URI has none (default: driftwatch)
# DRIFTWATCH_DB="driftwatch"

# --- required from milestone 2 (collector create/run/heal) ---
# Account API token from brightdata.com/cp/setting/users — NOT a Web Access API zone.
BRIGHTDATA_API_KEY=""

# --- optional: query agent (milestone 12). Provider-agnostic. ---
# DRIFTWATCH_LLM_PROVIDER="anthropic"   # anthropic | openai
# DRIFTWATCH_LLM_MODEL="claude-opus-5"  # required when provider=openai
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# OPENAI_BASE_URL=""                    # OpenRouter / Groq / vLLM / Ollama
